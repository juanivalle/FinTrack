# Database
DATABASE_URL="postgresql://fintrack_user:fintrack_password@127.0.0.1:5432/fintrack_db?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Auth
JWT_SECRET="super_secret_jwt_key_changed_in_production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="super_secret_refresh_key_changed_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV="development"

# External APIs (Placeholders)
BINANCE_API_URL="https://api.binance.com/api/v3"
STOCK_API_UKEY="your_stock_api_key"

# Notifications (Placeholders)
SMTP_HOST="smtp.example.com"
SMTP_USER="user"
SMTP_PASS="pass"
TWILIO_SID="ACxxx"
TWILIO_TOKEN="xxx"
TWILIO_FROM="+1234567890"
